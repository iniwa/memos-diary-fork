# Copy to .env and fill in values before running docker-compose.diary.yml
# .env is gitignored — do not commit actual values.

# Docker image to use for memos-diary container
# Build locally: docker build -f scripts/Dockerfile -t memos-diary:latest .
# Or use GHCR image (built by GitHub Actions via Gitea mirror):
# DIARY_IMAGE=ghcr.io/iniwa/memos-diary:latest
DIARY_IMAGE=memos-diary:latest
