# Copy to .env and fill in values before running docker-compose.diary.yml.
# .env is gitignored; do not commit actual values.

# Docker image to use for memos-diary container.
# Build locally: docker build -f scripts/Dockerfile -t memos-diary:latest .
# Or use GHCR image (built by GitHub Actions via Gitea mirror):
# DIARY_IMAGE=ghcr.io/iniwa/memos-diary-fork:latest
DIARY_IMAGE=memos-diary:latest

# Static image optimization is opt-in.
# Recommended first rollout keeps originals and pre-generates thumbnail cache.
MEMOS_IMAGE_OPTIMIZER_ENABLED=false
MEMOS_IMAGE_OPTIMIZER_CONCURRENCY=1
MEMOS_IMAGE_PREVIEW_MAX_EDGE=2560
MEMOS_IMAGE_PREVIEW_JPEG_QUALITY=90
MEMOS_IMAGE_THUMBNAIL_MAX_EDGE=720
MEMOS_IMAGE_THUMBNAIL_JPEG_QUALITY=78
MEMOS_IMAGE_KEEP_ORIGINAL=true
